menu "NEON LINK configuration"

choice NEON_BOARD
    prompt "Target hardware"
    default NEON_BOARD_CUSTOM
    help
        Board profile selects the pin map, pulse path, and CV drivers.
        AMYboard is the FEATURES.md v1 platform (10HP Eurorack module).
        P4-Module-DEV-KIT is the v2 R&D Waveshare board + I2C OLED.
        link-sync is the XIAO ESP32S3 MIDI-clock dongle (docs/LINKSYNC.md).
        link-sync-epd is the same dongle with a Waveshare 5.79" e-Paper
        (docs/LINKSYNC_EPD.md).
        link-sync-p4lcd is CrowPanel Advance 5.0" ESP32-P4 RGB LCD.
        link-sync-tab5 is M5Stack Tab5 (ESP32-P4 MIPI-DSI 720×1280).
        link-sync-c3oled is the ACEIRMC / Super Mini ESP32-C3 stamp
        with a 0.42" 72×40 OLED (docs/LINKSYNC_C3OLED.md).
        link-sync-matouch is the Makerfabs MaTouch ESP32-S3 1.28"
        Rotary — 240×240 round GC9A01 + rotary encoder
        (docs/LINKSYNC_MATOUCH.md).
        link-sync-rlcd is the Waveshare ESP32-S3-RLCD-4.2 — 400×300
        ST7305 reflective LCD, live beat display, battery gauge
        (docs/LINKSYNC_RLCD.md).
        link-sync-jc3248 is the Guition JC3248W535 (ESP32-S3-N16R8) —
        3.5" 320×480 AXS15231B QSPI IPS + cap touch
        (docs/LINKSYNC_JC3248.md).

config NEON_BOARD_CUSTOM
    bool "Custom NEON LINK PCB (GPIO clocks + LEDC tempo CV)"
config NEON_BOARD_AMYBOARD
    bool "AMYboard (GP8413 CV outs, ADS1015 CV ins, TRS MIDI)"
config NEON_BOARD_P4DEVKIT
    bool "Waveshare ESP32-P4-Module-DEV-KIT (I2C OLED, no radio)"
config NEON_BOARD_LINKSYNC
    bool "link-sync dongle (Seeed XIAO ESP32S3, TRS MIDI clock)"
config NEON_BOARD_LINKSYNC_EPD
    bool "link-sync (Waveshare 5.79\" e-Paper + ESP32-S3)"
config NEON_BOARD_LINKSYNC_P4LCD
    bool "link-sync (CrowPanel Advance 5.0\" ESP32-P4 RGB LCD)"
config NEON_BOARD_LINKSYNC_TAB5
    bool "link-sync (M5Stack Tab5 ESP32-P4 MIPI LCD)"
config NEON_BOARD_LINKSYNC_C3OLED
    bool "link-sync (ESP32-C3 0.42\" OLED stamp)"
config NEON_BOARD_LINKSYNC_MATOUCH
    bool "link-sync (MaTouch ESP32-S3 1.28\" round GC9A01 + encoder)"
config NEON_BOARD_LINKSYNC_RLCD
    bool "link-sync (Waveshare ESP32-S3-RLCD-4.2 reflective LCD)"
config NEON_BOARD_LINKSYNC_JC3248
    bool "link-sync (Guition JC3248W535 ESP32-S3 3.5\" AXS15231B QSPI + touch)"
endchoice

config NEON_LINKSYNC
    bool
    default y if NEON_BOARD_LINKSYNC || NEON_BOARD_LINKSYNC_EPD || NEON_BOARD_LINKSYNC_P4LCD || NEON_BOARD_LINKSYNC_TAB5 || NEON_BOARD_LINKSYNC_C3OLED || NEON_BOARD_LINKSYNC_MATOUCH || NEON_BOARD_LINKSYNC_RLCD || NEON_BOARD_LINKSYNC_JC3248
    help
        Shared link-sync firmware path: Link + MIDI clock. The XIAO uses
        a single LED; the e-Paper board uses the 5.79" panel; the P4 LCD
        board paints the same status live (and can click its onboard
        speakers when NEON_AUDIO is on); the C3 stamp uses the onboard
        72×40 OLED.

config NEON_AUDIO
    bool "Audio engine (I2S out, metronome, pulses as audio)"
    default y if NEON_BOARD_AMYBOARD
    default n
    help
        Brings up the AMYboard's I2S audio path: a 48 kHz stereo render
        loop on core 1, the metronome, clock/reset/run as sample-accurate
        audio, and the Link Audio taps. Off leaves the codecs idle and
        costs nothing.

config NEON_AUDIO_INPUT
    bool "Audio input (PCM3060 ADC / line in)"
    depends on NEON_AUDIO
    default n
    help
        Enables the I2S receive side: line-in monitoring, input meters,
        and the "<name> In" Link Audio channel. Off by default: a duplex
        DMA ring on the S3 ate ~64 kB of internal RAM and the chip
        rebooted as soon as WiFi associated. Leave this off unless you
        have measured the heap.

config NEON_AUDIO_AMY
    bool "AMY synth voice (third_party/amy)"
    depends on NEON_AUDIO
    default n
    help
        Renders incoming MIDI notes through shorepine's AMY (MIT), which
        must be checked out at third_party/amy. With this off the audio
        engine uses its own small built-in voice instead, so the Synth
        role and the MIDI routing behave the same either way.

menu "I2S pin map"
    depends on NEON_AUDIO

comment "-1 disables a pin. AMYBOARD = PCM3060 LINE; P4DEVKIT = ES8311 jack."
comment "LINKSYNC_P4LCD = dual NS4168 speaker amps (no MCLK, no input)."
comment "Audio stays silent (and says so) until DOUT/BCLK/LRCLK are set."

config NEON_I2S_MCLK
    int "MCLK (master clock, 256fs)"
    default 3 if NEON_BOARD_AMYBOARD
    default 13 if NEON_BOARD_P4DEVKIT
    default 16 if NEON_BOARD_LINKSYNC_RLCD
    default -1

config NEON_I2S_BCLK
    int "BCLK (bit clock)"
    default 8 if NEON_BOARD_AMYBOARD
    default 12 if NEON_BOARD_P4DEVKIT
    default 22 if NEON_BOARD_LINKSYNC_P4LCD
    default 9 if NEON_BOARD_LINKSYNC_RLCD
    default -1

config NEON_I2S_LRCLK
    int "LRCLK / WS (word select)"
    default 2 if NEON_BOARD_AMYBOARD
    default 10 if NEON_BOARD_P4DEVKIT
    default 21 if NEON_BOARD_LINKSYNC_P4LCD
    default 45 if NEON_BOARD_LINKSYNC_RLCD
    default -1

config NEON_I2S_DOUT
    int "DOUT (ESP → DAC)"
    default 6 if NEON_BOARD_AMYBOARD
    default 9 if NEON_BOARD_P4DEVKIT
    default 23 if NEON_BOARD_LINKSYNC_P4LCD
    default 8 if NEON_BOARD_LINKSYNC_RLCD
    default -1

config NEON_I2S_DIN
    int "DIN (ADC → ESP; unused unless NEON_AUDIO_INPUT)"
    default 9 if NEON_BOARD_AMYBOARD
    default 11 if NEON_BOARD_P4DEVKIT
    default -1

endmenu

config NEON_WIFI_SSID
    string "WiFi SSID"
    default ""
    help
        Station-mode network to join at boot. Leave empty to skip WiFi
        (Link still forms a local session). The web editor / setup AP
        can also store credentials in NVS after first boot.

config NEON_WIFI_PASSWORD
    string "WiFi password"
    default ""

endmenu

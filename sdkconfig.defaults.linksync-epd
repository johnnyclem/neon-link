# link-sync on Waveshare 5.79" e-Paper + ESP32-S3-DevKitC-1 N8R8.
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.linksync-epd" build
#
# 8 MB octal PSRAM. USB Serial/JTAG. Same MIDI clock path as the XIAO
# dongle; the panel is the status surface. See docs/LINKSYNC_EPD.md.

CONFIG_NEON_BOARD_LINKSYNC_EPD=y
# CONFIG_NEON_BOARD_CUSTOM is not set
# CONFIG_NEON_BOARD_AMYBOARD is not set
# CONFIG_NEON_BOARD_LINKSYNC is not set
# CONFIG_NEON_AUDIO is not set

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# DevKit / Waveshare boards bring the console out a USB-UART (CH343/CP2102)
# on UART0. Native USB Serial/JTAG is the XIAO path, not this one.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set

CONFIG_UART_ISR_IN_IRAM=y

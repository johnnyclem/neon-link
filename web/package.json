{
  "name": "neon-link-web",
  "private": true,
  "version": "1.0.0",
  "description": "NEON LINK configuration interface, served from the module itself",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/embed.mjs",
    "build:styleguide": "vite build --config vite.config.styleguide.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  }
}

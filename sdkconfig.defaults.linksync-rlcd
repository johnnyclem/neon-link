# link-sync on the Waveshare ESP32-S3-RLCD-4.2 (ESP32-S3-WROOM-1-N16R8).
#   idf.py set-target esp32s3
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.linksync-rlcd" build
#
# 4.2" ST7305 reflective mono LCD (400×300 landscape) over SPI. 16 MB
# flash, 8 MB octal PSRAM, battery powered with a ÷3 VBAT divider on
# GPIO4. USB-C is native USB Serial/JTAG. Same MIDI-clock path as the
# other dongles; the reflective panel is a live status surface that
# drops to a 1 Hz low-power scan when idle. See docs/LINKSYNC_RLCD.md.

CONFIG_NEON_BOARD_LINKSYNC_RLCD=y
# CONFIG_NEON_BOARD_CUSTOM is not set
# CONFIG_NEON_BOARD_AMYBOARD is not set
# CONFIG_NEON_BOARD_P4DEVKIT is not set
# CONFIG_NEON_BOARD_LINKSYNC is not set
# CONFIG_NEON_BOARD_LINKSYNC_EPD is not set
# CONFIG_NEON_BOARD_LINKSYNC_P4LCD is not set
# CONFIG_NEON_BOARD_LINKSYNC_TAB5 is not set
# CONFIG_NEON_BOARD_LINKSYNC_C3OLED is not set
# CONFIG_NEON_BOARD_LINKSYNC_MATOUCH is not set

# Onboard ES8311 DAC + speaker amp (PA GPIO46). Click is opt-in:
# AUDIO > AUDIO ON, then METRONOME ON. metro_enabled / audio.enabled
# stay 0 in Config. DIN 10 is the vendor ADC pin (FOLLOW still off).
CONFIG_NEON_AUDIO=y
CONFIG_NEON_I2S_DIN=10

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# ESP32-S3-N16R8: 8 MB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Native USB Serial/JTAG on the Type-C port (there is no USB-UART bridge).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART is not set

CONFIG_UART_ISR_IN_IRAM=y

# AMYboard overlay — use with:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.amyboard" build
#
# AMYboard modules ship with 16 MB flash + octal PSRAM. Neon-link does not
# need PSRAM for the pulse path; we only bump the flash size so esptool
# matches the part.

CONFIG_NEON_BOARD_AMYBOARD=y
# CONFIG_NEON_BOARD_CUSTOM is not set

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Match stock AMYboard flash clocking (octal PSRAM companion).
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# AMYboard ESP32-S3-WROOM modules ship with 8 MB octal PSRAM. WiFi + NimBLE
# + Ableton Link need the headroom; without SPIRAM the app OOM-crashes in
# startup and produces no console output.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# AMYboard only exposes the ESP32-S3 native USB (Serial/JTAG) to the host.
# Put the primary console there so `idf.py monitor` works over USB-C.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART is not set

# 16 MB partition table: 6 MB OTA slots. The 8 MB table's 3 MB slots do not
# fit Link 4 plus the audio engine, and the flash is there.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# Audio engine (docs/AUDIOLINK.md). The I2S pins still have to come from
# the board schematic — see the "I2S pin map" menu; until they are set the
# engine reports itself as unavailable instead of half-working.
CONFIG_NEON_AUDIO=y
CONFIG_NEON_AUDIO_INPUT=y

# Link Audio's receive path holds ~250 ms of 48 kHz stereo, and publishing
# a mix keeps a socket busy alongside Link's own discovery traffic.
CONFIG_LWIP_MAX_SOCKETS=20

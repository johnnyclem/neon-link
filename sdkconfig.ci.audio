# CI matrix leg: the audio engine compiled in, with the AMY seam on its
# built-in voice. Combined with sdkconfig.defaults (and, for the
# amyboard-audio variant, sdkconfig.defaults.amyboard which turns
# NEON_LINK_AUDIO on against the Link-4.0 submodule). The stub-audio
# variant still proves the no-op ILinkAudio because NEON_LINK_STUB
# disables NEON_LINK_AUDIO.
CONFIG_NEON_AUDIO=y
CONFIG_NEON_AUDIO_INPUT=y
# CONFIG_NEON_AUDIO_AMY is not set

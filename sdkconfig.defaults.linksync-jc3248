# link-sync on the Guition JC3248W535 (ESP32-S3-WROOM-1-N16R8).
#   idf.py set-target esp32s3
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.linksync-jc3248" build
#
# 3.5" 320×480 AXS15231B IPS over QSPI (SPI2) + AXS15231B cap-touch on
# I2C (0x3B). 16 MB flash, 8 MB octal PSRAM, native USB-C Serial/JTAG.
# Backlight is LEDC PWM on GPIO1. Same MIDI-clock path as the other
# dongles; the panel is the live status surface. See docs/LINKSYNC_JC3248.md.

CONFIG_NEON_BOARD_LINKSYNC_JC3248=y
# CONFIG_NEON_BOARD_CUSTOM is not set
# CONFIG_NEON_BOARD_AMYBOARD is not set
# CONFIG_NEON_BOARD_P4DEVKIT is not set
# CONFIG_NEON_BOARD_LINKSYNC is not set
# CONFIG_NEON_BOARD_LINKSYNC_EPD is not set
# CONFIG_NEON_BOARD_LINKSYNC_P4LCD is not set
# CONFIG_NEON_BOARD_LINKSYNC_TAB5 is not set
# CONFIG_NEON_BOARD_LINKSYNC_C3OLED is not set
# CONFIG_NEON_BOARD_LINKSYNC_MATOUCH is not set
# CONFIG_NEON_BOARD_LINKSYNC_RLCD is not set
# CONFIG_NEON_AUDIO is not set

# 16 MB flash. The demo ships QIO @ 80 MHz; keep that.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# ESP32-S3-N16R8: 8 MB octal PSRAM. The full 320×480 RGB565 framebuffer
# (300 KB) lives here, so PSRAM must be up before the display task.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Native USB Serial/JTAG on the Type-C port (there is no USB-UART bridge).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART is not set

CONFIG_UART_ISR_IN_IRAM=y
